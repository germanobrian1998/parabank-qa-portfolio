    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transactions for Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each transaction has required fields', function () {",
                  "    const transactions = pm.response.json();",
                  "    if (transactions.length === 0) return;",
                  "    transactions.forEach(function(tx) {",
                  "        pm.expect(tx).to.have.property('id');",
                  "        pm.expect(tx).to.have.property('amount');",
                  "        pm.expect(tx).to.have.property('type');",
                  "        pm.expect(tx).to.have.property('date');",
                  "    });",
                  "});",
                  "",
                  "const transactions = pm.response.json();",
                  "pm.environment.set('transactionCount', transactions.length);",
                  "if (transactions.length > 0) {",
                  "    pm.environment.set('lastTransactionId', transactions[0].id);",
                  "}",
                  "console.log('Transacciones encontradas:', transactions.length);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/services/bank/accounts/{{fromAccountId}}/transactions",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "services",
                "bank",
                "accounts",
                "{{fromAccountId}}",
                "transactions"
              ]
            }
          },
          "response": []
        }
      ]
    }
