      "item": [
        {
          "name": "Login — john/demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains customerId', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.environment.set('customerId', body.id);",
                  "pm.environment.set('firstName', body.firstName);",
                  "console.log('customerId capturado:', body.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
