    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get Customer Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array with at least 2 accounts', function () {",
                  "    const accounts = pm.response.json();",
                  "    pm.expect(accounts).to.be.an('array');",
                  "    pm.expect(accounts.length).to.be.at.least(2);",
                  "});",
                  "",
                  "const accounts = pm.response.json();",
                  "const sorted = accounts.slice().sort((a, b) => b.balance - a.balance);",
                  "",
                  "pm.environment.set('fromAccountId', sorted[0].id);",
                  "pm.environment.set('fromAccountBalance', sorted[0].balance);",
                  "pm.environment.set('toAccountId', sorted[1].id);",
                  "pm.environment.set('toAccountBalance', sorted[1].balance);",
                  "",
                  "console.log('fromAccountId:', sorted[0].id, '| balance:', sorted[0].balance);",
                  "console.log('toAccountId:', sorted[1].id, '| balance:', sorted[1].balance);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/services/bank/customers/{{customerId}}/accounts",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "services",
                "bank",
                "customers",
                "{{customerId}}",
                "accounts"
              ]
            }
          },
          "response": []
        }
      ]
    },
